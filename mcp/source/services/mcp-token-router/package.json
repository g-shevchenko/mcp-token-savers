{
  "name": "mcp-token-router",
  "version": "0.1.0",
  "description": "Measurement-driven routing MCP — picks the right deterministic compressor (hwai/sophon/contextprep) based on input size and budget. Rules backed by the c2_bench measurement program.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "bash ./scripts/smoke-local.sh",
    "measurement:report": "node ./scripts/measurement-report.mjs",
    "prepare": "npm run build"
  },
  "bin": {
    "mcp-token-router": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
