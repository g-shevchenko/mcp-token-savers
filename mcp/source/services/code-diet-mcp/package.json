{
  "name": "@hwai/code-diet-mcp",
  "version": "0.1.0",
  "description": "Local-first diff-scoped code review + AI-code diet MCP: deterministic AI-slop detection, delete-first reports, risk-scored review",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "npm run build && node ./scripts/benchmark-local.mjs",
    "smoke": "bash ./scripts/smoke-local.sh",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "mcp",
    "code-review",
    "ai-slop",
    "refactoring",
    "dead-code",
    "pantheon-safe"
  ],
  "author": "Humanswith.ai",
  "license": "MIT"
}
